# /collins/saa/relay.env (root:saaa, mode 0640)
SAAA_ADDR=127.0.0.1:8787
SAAA_DATA=/collins/saa/data
SAAA_TRUST_PROXY=1
SAAA_RATE_PER_MINUTE=240
SAAA_MAX_BODY_MB=8
# Uncomment to require an invitation code when connecting a key:
# SAAA_REGISTRATION_CODE=
# Hosted accounts (beta): invite holders use the key in this file.
# SAAA_HOSTED=1
# SAAA_HOSTED_KEY_FILE=/collins/saa/hosted.key
# SAAA_HOSTED_BUDGET_USD=5
# SAAA_HOSTED_MODELS=claude-haiku-5-5,claude-sonnet-5-5
